# ---------------------------------------------------------------
# Clinicyza Web — environment variables
# Copy this file to .env.local and fill in real values.
# NEXT_PUBLIC_* values are exposed to the browser — never put secrets in them.
# ---------------------------------------------------------------

# Public URL of this website (used for metadata, canonical links, OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Backend API (clinicyza-server)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Patient / doctor portal (clinicyza-portals)
NEXT_PUBLIC_PORTAL_URL=http://localhost:3002

# Analytics (optional) — leave empty to disable
NEXT_PUBLIC_GA_MEASUREMENT_ID=
